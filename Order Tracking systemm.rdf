<?xml version="1.0"?>
<rdf:RDF xmlns="http://www.semanticweb.org/laptop/ontologies/2026/3/untitled-ontology-164/"
     xml:base="http://www.semanticweb.org/laptop/ontologies/2026/3/untitled-ontology-164/"
     xmlns:gr="http://purl.org/goodrelations/v1#"
     xmlns:iao="http://purl.obolibrary.org/obo/"
     xmlns:owl="http://www.w3.org/2002/07/owl#"
     xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#"
     xmlns:xml="http://www.w3.org/XML/1998/namespace"
     xmlns:xsd="http://www.w3.org/2001/XMLSchema#"
     xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#"
     xmlns:terms="http://purl.org/dc/terms/"
     xmlns:vcard="http://www.w3.org/2006/vcard/ns#"
     xmlns:schema="https://schema.org/"
     xmlns:schema1="http://schema.org/"
     xmlns:untitled-ontology-164="http://www.semanticweb.org/laptop/ontologies/2026/3/untitled-ontology-164#">
    <owl:Ontology rdf:about="http://www.semanticweb.org/laptop/ontologies/2026/3/untitled-ontology-164">
        <terms:license rdf:resource="http://creativecommons.org/licenses/by/4.0/"/>
        <rdfs:comment>An ontology designed for managing orders, tracking, and shipments.</rdfs:comment>
        <rdfs:label>Tracking System Ontology</rdfs:label>
    </owl:Ontology>
    


    <!-- 
    ///////////////////////////////////////////////////////////////////////////////////////
    //
    // Annotation properties
    //
    ///////////////////////////////////////////////////////////////////////////////////////
     -->

    


    <!-- http://purl.org/dc/terms/license -->

    <owl:AnnotationProperty rdf:about="http://purl.org/dc/terms/license"/>
    


    <!-- 
    ///////////////////////////////////////////////////////////////////////////////////////
    //
    // Datatypes
    //
    ///////////////////////////////////////////////////////////////////////////////////////
     -->

    


    <!-- http://www.w3.org/2001/XMLSchema#date -->

    <rdfs:Datatype rdf:about="http://www.w3.org/2001/XMLSchema#date"/>
    


    <!-- 
    ///////////////////////////////////////////////////////////////////////////////////////
    //
    // Object Properties
    //
    ///////////////////////////////////////////////////////////////////////////////////////
     -->

    


    <!-- http://purl.org/dc/terms/isPartOf -->

    <owl:ObjectProperty rdf:about="http://purl.org/dc/terms/isPartOf">
        <owl:inverseOf rdf:resource="http://www.semanticweb.org/laptop/ontologies/2026/3/untitled-ontology-164#containsItem"/>
        <rdfs:domain rdf:resource="https://schema.org/OrderItem"/>
        <rdfs:range rdf:resource="http://www.semanticweb.org/laptop/ontologies/2026/3/untitled-ontology-164#Order"/>
        <rdfs:comment>Relates an order item to its encompassing order.</rdfs:comment>
        <rdfs:label>is part of</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://schema.org/deliveryAddress -->

    <owl:ObjectProperty rdf:about="http://schema.org/deliveryAddress">
        <owl:inverseOf rdf:resource="http://www.semanticweb.org/laptop/ontologies/2026/3/untitled-ontology-164#isDeliveryAddressOf"/>
        <rdfs:domain>
            <owl:Class>
                <owl:unionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="http://www.semanticweb.org/laptop/ontologies/2026/3/untitled-ontology-164#Order"/>
                    <rdf:Description rdf:about="http://www.semanticweb.org/laptop/ontologies/2026/3/untitled-ontology-164#Shipment"/>
                </owl:unionOf>
            </owl:Class>
        </rdfs:domain>
        <rdfs:range rdf:resource="http://www.semanticweb.org/laptop/ontologies/2026/3/untitled-ontology-164#Address"/>
        <rdfs:comment>The address where the order or shipment will be delivered.</rdfs:comment>
        <rdfs:label>delivery address</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://schema.org/orderedItem -->

    <owl:ObjectProperty rdf:about="http://schema.org/orderedItem">
        <owl:inverseOf rdf:resource="http://www.semanticweb.org/laptop/ontologies/2026/3/untitled-ontology-164#isOrderedIn"/>
        <rdfs:domain rdf:resource="https://schema.org/OrderItem"/>
        <rdfs:range rdf:resource="https://schema.org/Product"/>
        <rdfs:comment>The specific product included in the order item.</rdfs:comment>
        <rdfs:label>ordered item</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/laptop/ontologies/2026/3/untitled-ontology-164#containsItem -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/laptop/ontologies/2026/3/untitled-ontology-164#containsItem">
        <rdfs:domain rdf:resource="http://www.semanticweb.org/laptop/ontologies/2026/3/untitled-ontology-164#Order"/>
        <rdfs:range rdf:resource="https://schema.org/OrderItem"/>
        <rdfs:comment>Relates an order to its constituent items.</rdfs:comment>
        <rdfs:label>contains item</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/laptop/ontologies/2026/3/untitled-ontology-164#generatesInvoice -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/laptop/ontologies/2026/3/untitled-ontology-164#generatesInvoice">
        <owl:inverseOf rdf:resource="http://www.semanticweb.org/laptop/ontologies/2026/3/untitled-ontology-164#isInvoiceGeneratedBy"/>
        <rdfs:domain rdf:resource="http://www.semanticweb.org/laptop/ontologies/2026/3/untitled-ontology-164#Order"/>
        <rdfs:range rdf:resource="http://www.semanticweb.org/laptop/ontologies/2026/3/untitled-ontology-164#Invoice"/>
        <rdfs:comment>Links an order to its generated invoice.</rdfs:comment>
        <rdfs:label>generates invoice</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/laptop/ontologies/2026/3/untitled-ontology-164#handledBy -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/laptop/ontologies/2026/3/untitled-ontology-164#handledBy">
        <owl:inverseOf rdf:resource="http://www.semanticweb.org/laptop/ontologies/2026/3/untitled-ontology-164#handlesShipment"/>
        <rdfs:domain rdf:resource="http://www.semanticweb.org/laptop/ontologies/2026/3/untitled-ontology-164#Shipment"/>
        <rdfs:range rdf:resource="https://schema.org/Organization#Courier"/>
        <rdfs:comment>Specifies the courier handling the shipment.</rdfs:comment>
        <rdfs:label>handled by</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/laptop/ontologies/2026/3/untitled-ontology-164#handlesShipment -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/laptop/ontologies/2026/3/untitled-ontology-164#handlesShipment">
        <rdfs:comment>Relates a courier to the shipments it handles.</rdfs:comment>
        <rdfs:label>handles shipment</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/laptop/ontologies/2026/3/untitled-ontology-164#hasCancellation -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/laptop/ontologies/2026/3/untitled-ontology-164#hasCancellation">
        <owl:inverseOf rdf:resource="http://www.semanticweb.org/laptop/ontologies/2026/3/untitled-ontology-164#isCancellationOf"/>
        <rdfs:domain rdf:resource="http://www.semanticweb.org/laptop/ontologies/2026/3/untitled-ontology-164#Order"/>
        <rdfs:range rdf:resource="http://www.semanticweb.org/laptop/ontologies/2026/3/untitled-ontology-164#Cancellation"/>
        <rdfs:comment>Links an order to a cancellation record.</rdfs:comment>
        <rdfs:label>has cancellation</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/laptop/ontologies/2026/3/untitled-ontology-164#hasPayment -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/laptop/ontologies/2026/3/untitled-ontology-164#hasPayment">
        <owl:inverseOf rdf:resource="http://www.semanticweb.org/laptop/ontologies/2026/3/untitled-ontology-164#isPaymentOf"/>
        <rdfs:domain rdf:resource="http://www.semanticweb.org/laptop/ontologies/2026/3/untitled-ontology-164#Order"/>
        <rdfs:range rdf:resource="http://www.semanticweb.org/laptop/ontologies/2026/3/untitled-ontology-164#Payment"/>
        <rdfs:comment>Relates an order to its payment details.</rdfs:comment>
        <rdfs:label>has payment</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/laptop/ontologies/2026/3/untitled-ontology-164#hasReturnRequest -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/laptop/ontologies/2026/3/untitled-ontology-164#hasReturnRequest">
        <owl:inverseOf rdf:resource="http://www.semanticweb.org/laptop/ontologies/2026/3/untitled-ontology-164#isReturnRequestOf"/>
        <rdfs:domain rdf:resource="http://www.semanticweb.org/laptop/ontologies/2026/3/untitled-ontology-164#Order"/>
        <rdfs:range rdf:resource="http://www.semanticweb.org/laptop/ontologies/2026/3/untitled-ontology-164#ReturnRequest"/>
        <rdfs:comment>Links an order to a potential return request.</rdfs:comment>
        <rdfs:label>has return request</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/laptop/ontologies/2026/3/untitled-ontology-164#hasShipment -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/laptop/ontologies/2026/3/untitled-ontology-164#hasShipment">
        <owl:inverseOf rdf:resource="http://www.semanticweb.org/laptop/ontologies/2026/3/untitled-ontology-164#isShipmentOf"/>
        <rdfs:domain rdf:resource="http://www.semanticweb.org/laptop/ontologies/2026/3/untitled-ontology-164#Order"/>
        <rdfs:range rdf:resource="http://www.semanticweb.org/laptop/ontologies/2026/3/untitled-ontology-164#Shipment"/>
        <rdfs:comment>Links an order to its shipment dispatch details.</rdfs:comment>
        <rdfs:label>has shipment</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/laptop/ontologies/2026/3/untitled-ontology-164#hasTracking -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/laptop/ontologies/2026/3/untitled-ontology-164#hasTracking">
        <owl:inverseOf rdf:resource="http://www.semanticweb.org/laptop/ontologies/2026/3/untitled-ontology-164#isTrackingOf"/>
        <rdfs:domain rdf:resource="http://www.semanticweb.org/laptop/ontologies/2026/3/untitled-ontology-164#Shipment"/>
        <rdfs:range rdf:resource="http://www.semanticweb.org/laptop/ontologies/2026/3/untitled-ontology-164#Tracking"/>
        <rdfs:comment>Relates a shipment to its tracking events.</rdfs:comment>
        <rdfs:label>has tracking</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/laptop/ontologies/2026/3/untitled-ontology-164#isCancellationOf -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/laptop/ontologies/2026/3/untitled-ontology-164#isCancellationOf">
        <rdfs:comment>Links a cancellation to the specific order.</rdfs:comment>
        <rdfs:label>is cancellation of</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/laptop/ontologies/2026/3/untitled-ontology-164#isDeliveryAddressOf -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/laptop/ontologies/2026/3/untitled-ontology-164#isDeliveryAddressOf">
        <rdfs:comment>Relates an address back to the shipment or order.</rdfs:comment>
        <rdfs:label>is delivery address of</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/laptop/ontologies/2026/3/untitled-ontology-164#isInvoiceGeneratedBy -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/laptop/ontologies/2026/3/untitled-ontology-164#isInvoiceGeneratedBy">
        <rdfs:comment>Relates an invoice back to the order.</rdfs:comment>
        <rdfs:label>is invoice generated by</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/laptop/ontologies/2026/3/untitled-ontology-164#isNotifiedBy -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/laptop/ontologies/2026/3/untitled-ontology-164#isNotifiedBy">
        <owl:inverseOf rdf:resource="http://www.semanticweb.org/laptop/ontologies/2026/3/untitled-ontology-164#notifiesCustomer"/>
        <rdfs:comment>Relates a customer to the notification they received.</rdfs:comment>
        <rdfs:label>is notified by</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/laptop/ontologies/2026/3/untitled-ontology-164#isOrderedIn -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/laptop/ontologies/2026/3/untitled-ontology-164#isOrderedIn">
        <rdfs:comment>Relates a product to the order item it belongs to.</rdfs:comment>
        <rdfs:label>is ordered in</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/laptop/ontologies/2026/3/untitled-ontology-164#isPaymentOf -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/laptop/ontologies/2026/3/untitled-ontology-164#isPaymentOf">
        <rdfs:comment>Relates a payment back to the relevant order.</rdfs:comment>
        <rdfs:label>is payment of</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/laptop/ontologies/2026/3/untitled-ontology-164#isPlacedBy -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/laptop/ontologies/2026/3/untitled-ontology-164#isPlacedBy">
        <owl:inverseOf rdf:resource="http://www.semanticweb.org/laptop/ontologies/2026/3/untitled-ontology-164#placesOrder"/>
        <rdfs:comment>Links an order to the specific customer who placed it.</rdfs:comment>
        <rdfs:label>is placed by</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/laptop/ontologies/2026/3/untitled-ontology-164#isReturnRequestOf -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/laptop/ontologies/2026/3/untitled-ontology-164#isReturnRequestOf">
        <rdfs:comment>Links a return request to the specific order.</rdfs:comment>
        <rdfs:label>is return request of</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/laptop/ontologies/2026/3/untitled-ontology-164#isShipmentOf -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/laptop/ontologies/2026/3/untitled-ontology-164#isShipmentOf">
        <rdfs:domain rdf:resource="http://www.semanticweb.org/laptop/ontologies/2026/3/untitled-ontology-164#Shipment"/>
        <rdfs:range rdf:resource="http://www.semanticweb.org/laptop/ontologies/2026/3/untitled-ontology-164#Order"/>
        <rdfs:comment>Links a shipment directly back to the related order.</rdfs:comment>
        <rdfs:label>is shipment of</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/laptop/ontologies/2026/3/untitled-ontology-164#isTrackingOf -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/laptop/ontologies/2026/3/untitled-ontology-164#isTrackingOf">
        <rdfs:comment>Relates tracking details back to the shipment.</rdfs:comment>
        <rdfs:label>is tracking of</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/laptop/ontologies/2026/3/untitled-ontology-164#notificationSentBy -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/laptop/ontologies/2026/3/untitled-ontology-164#notificationSentBy">
        <owl:inverseOf rdf:resource="http://www.semanticweb.org/laptop/ontologies/2026/3/untitled-ontology-164#sendsNotification"/>
        <rdfs:comment>Relates a notification to the administrator who sent it.</rdfs:comment>
        <rdfs:label>notification sent by</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/laptop/ontologies/2026/3/untitled-ontology-164#notifiesCustomer -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/laptop/ontologies/2026/3/untitled-ontology-164#notifiesCustomer">
        <rdfs:domain rdf:resource="http://www.semanticweb.org/laptop/ontologies/2026/3/untitled-ontology-164#Notification"/>
        <rdfs:range rdf:resource="http://www.semanticweb.org/laptop/ontologies/2026/3/untitled-ontology-164#Customer"/>
        <rdfs:comment>Relates a notification entity to the customer receiving it.</rdfs:comment>
        <rdfs:label>notifies customer</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/laptop/ontologies/2026/3/untitled-ontology-164#placesOrder -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/laptop/ontologies/2026/3/untitled-ontology-164#placesOrder">
        <rdfs:domain rdf:resource="http://www.semanticweb.org/laptop/ontologies/2026/3/untitled-ontology-164#Customer"/>
        <rdfs:range rdf:resource="http://www.semanticweb.org/laptop/ontologies/2026/3/untitled-ontology-164#Order"/>
        <rdfs:comment>Indicates that a customer has initiated an order.</rdfs:comment>
        <rdfs:label>places order</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/laptop/ontologies/2026/3/untitled-ontology-164#sells -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/laptop/ontologies/2026/3/untitled-ontology-164#sells">
        <owl:inverseOf rdf:resource="http://www.semanticweb.org/laptop/ontologies/2026/3/untitled-ontology-164#soldBy"/>
        <rdfs:comment>Links a seller to the products they offer.</rdfs:comment>
        <rdfs:label>sells</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/laptop/ontologies/2026/3/untitled-ontology-164#sendsNotification -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/laptop/ontologies/2026/3/untitled-ontology-164#sendsNotification">
        <rdfs:domain rdf:resource="http://www.semanticweb.org/laptop/ontologies/2026/3/untitled-ontology-164#Admin"/>
        <rdfs:range rdf:resource="http://www.semanticweb.org/laptop/ontologies/2026/3/untitled-ontology-164#Notification"/>
        <rdfs:comment>Links an administrative action to a system notification sent.</rdfs:comment>
        <rdfs:label>sends notification</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/laptop/ontologies/2026/3/untitled-ontology-164#soldBy -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/laptop/ontologies/2026/3/untitled-ontology-164#soldBy">
        <rdfs:domain rdf:resource="https://schema.org/Product"/>
        <rdfs:range rdf:resource="https://schema.org/Organization#Seller"/>
        <rdfs:comment>Links a product to the organization that sells it.</rdfs:comment>
        <rdfs:label>sold by</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- 
    ///////////////////////////////////////////////////////////////////////////////////////
    //
    // Data properties
    //
    ///////////////////////////////////////////////////////////////////////////////////////
     -->

    


    <!-- http://purl.org/dc/terms/date -->

    <owl:DatatypeProperty rdf:about="http://purl.org/dc/terms/date">
        <rdfs:domain>
            <owl:Class>
                <owl:unionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="http://www.semanticweb.org/laptop/ontologies/2026/3/untitled-ontology-164#Cancellation"/>
                    <rdf:Description rdf:about="http://www.semanticweb.org/laptop/ontologies/2026/3/untitled-ontology-164#Invoice"/>
                    <rdf:Description rdf:about="http://www.semanticweb.org/laptop/ontologies/2026/3/untitled-ontology-164#Notification"/>
                    <rdf:Description rdf:about="http://www.semanticweb.org/laptop/ontologies/2026/3/untitled-ontology-164#Payment"/>
                    <rdf:Description rdf:about="http://www.semanticweb.org/laptop/ontologies/2026/3/untitled-ontology-164#ReturnRequest"/>
                </owl:unionOf>
            </owl:Class>
        </rdfs:domain>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#dateTime"/>
        <rdfs:comment>A generic property for recording times/dates of various actions.</rdfs:comment>
        <rdfs:label>date</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://purl.org/dc/terms/description -->

    <owl:DatatypeProperty rdf:about="http://purl.org/dc/terms/description">
        <rdfs:domain>
            <owl:Class>
                <owl:unionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="http://www.semanticweb.org/laptop/ontologies/2026/3/untitled-ontology-164#Admin"/>
                    <rdf:Description rdf:about="http://www.semanticweb.org/laptop/ontologies/2026/3/untitled-ontology-164#Invoice"/>
                    <rdf:Description rdf:about="http://www.semanticweb.org/laptop/ontologies/2026/3/untitled-ontology-164#Notification"/>
                    <rdf:Description rdf:about="http://www.semanticweb.org/laptop/ontologies/2026/3/untitled-ontology-164#ReturnRequest"/>
                    <rdf:Description rdf:about="http://www.semanticweb.org/laptop/ontologies/2026/3/untitled-ontology-164#Tracking"/>
                    <rdf:Description rdf:about="https://schema.org/OrderItem"/>
                    <rdf:Description rdf:about="https://schema.org/Product"/>
                    <rdf:Description rdf:about="https://schema.org/Organization#Courier"/>
                    <rdf:Description rdf:about="https://schema.org/Organization#Seller"/>
                </owl:unionOf>
            </owl:Class>
        </rdfs:domain>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment>A generic text description of the entity.</rdfs:comment>
        <rdfs:label>description</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://schema.org/addressLocality -->

    <owl:DatatypeProperty rdf:about="http://schema.org/addressLocality">
        <rdfs:domain rdf:resource="http://www.semanticweb.org/laptop/ontologies/2026/3/untitled-ontology-164#Address"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment>The locality in which the street address is, and which is in the region.</rdfs:comment>
        <rdfs:label>address locality</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://schema.org/addressRegion -->

    <owl:DatatypeProperty rdf:about="http://schema.org/addressRegion">
        <rdfs:domain rdf:resource="http://www.semanticweb.org/laptop/ontologies/2026/3/untitled-ontology-164#Address"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment>The region in which the locality is, and which is in the country.</rdfs:comment>
        <rdfs:label>address region</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://schema.org/email -->

    <owl:DatatypeProperty rdf:about="http://schema.org/email">
        <rdfs:domain>
            <owl:Class>
                <owl:unionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="http://www.semanticweb.org/laptop/ontologies/2026/3/untitled-ontology-164#Customer"/>
                    <rdf:Description rdf:about="https://schema.org/Organization#Seller"/>
                </owl:unionOf>
            </owl:Class>
        </rdfs:domain>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment>The email address associated with a user or organization.</rdfs:comment>
        <rdfs:label>email</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://schema.org/orderDate -->

    <owl:DatatypeProperty rdf:about="http://schema.org/orderDate">
        <rdfs:domain rdf:resource="http://www.semanticweb.org/laptop/ontologies/2026/3/untitled-ontology-164#Order"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#dateTime"/>
        <rdfs:comment>The exact timestamp when the order was placed.</rdfs:comment>
        <rdfs:label>order date</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://schema.org/orderNumber -->

    <owl:DatatypeProperty rdf:about="http://schema.org/orderNumber">
        <rdfs:domain rdf:resource="http://www.semanticweb.org/laptop/ontologies/2026/3/untitled-ontology-164#Order"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment>The identifier for the order.</rdfs:comment>
        <rdfs:label>order number</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://schema.org/paymentMethod -->

    <owl:DatatypeProperty rdf:about="http://schema.org/paymentMethod">
        <rdfs:domain rdf:resource="http://www.semanticweb.org/laptop/ontologies/2026/3/untitled-ontology-164#Payment"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment>The method or instrument used for making the payment.</rdfs:comment>
        <rdfs:label>payment method</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://schema.org/postalCode -->

    <owl:DatatypeProperty rdf:about="http://schema.org/postalCode">
        <rdfs:domain rdf:resource="http://www.semanticweb.org/laptop/ontologies/2026/3/untitled-ontology-164#Address"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment>The postal code corresponding to the physical address.</rdfs:comment>
        <rdfs:label>postal code</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://schema.org/streetAddress -->

    <owl:DatatypeProperty rdf:about="http://schema.org/streetAddress">
        <rdfs:domain rdf:resource="http://www.semanticweb.org/laptop/ontologies/2026/3/untitled-ontology-164#Address"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment>The street address line containing building and street identifiers.</rdfs:comment>
        <rdfs:label>street address</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://schema.org/telephone -->

    <owl:DatatypeProperty rdf:about="http://schema.org/telephone">
        <rdfs:domain>
            <owl:Class>
                <owl:unionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="http://www.semanticweb.org/laptop/ontologies/2026/3/untitled-ontology-164#Customer"/>
                    <rdf:Description rdf:about="https://schema.org/Organization#Seller"/>
                </owl:unionOf>
            </owl:Class>
        </rdfs:domain>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment>The telephone number to contact the entity.</rdfs:comment>
        <rdfs:label>telephone</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://schema.org/trackingNumber -->

    <owl:DatatypeProperty rdf:about="http://schema.org/trackingNumber">
        <rdfs:domain rdf:resource="http://www.semanticweb.org/laptop/ontologies/2026/3/untitled-ontology-164#Shipment"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment>The tracking identifier assigned by the courier.</rdfs:comment>
        <rdfs:label>tracking number</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://www.semanticweb.org/laptop/ontologies/2026/3/untitled-ontology-164#categoryName -->

    <owl:DatatypeProperty rdf:about="http://www.semanticweb.org/laptop/ontologies/2026/3/untitled-ontology-164#categoryName">
        <rdfs:domain rdf:resource="https://schema.org/Product"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment>The generic category classification for a given product.</rdfs:comment>
        <rdfs:label>category name</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://www.semanticweb.org/laptop/ontologies/2026/3/untitled-ontology-164#country -->

    <owl:DatatypeProperty rdf:about="http://www.semanticweb.org/laptop/ontologies/2026/3/untitled-ontology-164#country">
        <rdfs:domain>
            <owl:Class>
                <owl:unionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="http://www.semanticweb.org/laptop/ontologies/2026/3/untitled-ontology-164#Address"/>
                    <rdf:Description rdf:about="http://www.semanticweb.org/laptop/ontologies/2026/3/untitled-ontology-164#Customer"/>
                    <rdf:Description rdf:about="https://schema.org/Organization#Seller"/>
                </owl:unionOf>
            </owl:Class>
        </rdfs:domain>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment>The country related to a customer, address, or seller.</rdfs:comment>
        <rdfs:label>country</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://www.semanticweb.org/laptop/ontologies/2026/3/untitled-ontology-164#customerId -->

    <owl:DatatypeProperty rdf:about="http://www.semanticweb.org/laptop/ontologies/2026/3/untitled-ontology-164#customerId">
        <rdfs:domain rdf:resource="http://www.semanticweb.org/laptop/ontologies/2026/3/untitled-ontology-164#Customer"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment>The unique string identifying a customer.</rdfs:comment>
        <rdfs:label>customer ID</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://www.semanticweb.org/laptop/ontologies/2026/3/untitled-ontology-164#customerName -->

    <owl:DatatypeProperty rdf:about="http://www.semanticweb.org/laptop/ontologies/2026/3/untitled-ontology-164#customerName">
        <rdfs:domain rdf:resource="http://www.semanticweb.org/laptop/ontologies/2026/3/untitled-ontology-164#Customer"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment>The full display name of the customer.</rdfs:comment>
        <rdfs:label>customer name</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://www.semanticweb.org/laptop/ontologies/2026/3/untitled-ontology-164#deliveryDate -->

    <owl:DatatypeProperty rdf:about="http://www.semanticweb.org/laptop/ontologies/2026/3/untitled-ontology-164#deliveryDate">
        <rdfs:domain rdf:resource="http://www.semanticweb.org/laptop/ontologies/2026/3/untitled-ontology-164#Shipment"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#dateTime"/>
        <rdfs:comment>The actual timestamp when the shipment was delivered.</rdfs:comment>
        <rdfs:label>delivery date</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://www.semanticweb.org/laptop/ontologies/2026/3/untitled-ontology-164#dispatchDate -->

    <owl:DatatypeProperty rdf:about="http://www.semanticweb.org/laptop/ontologies/2026/3/untitled-ontology-164#dispatchDate">
        <rdfs:domain rdf:resource="http://www.semanticweb.org/laptop/ontologies/2026/3/untitled-ontology-164#Shipment"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#dateTime"/>
        <rdfs:comment>The timestamp indicating when a shipment was sent out.</rdfs:comment>
        <rdfs:label>dispatch date</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://www.semanticweb.org/laptop/ontologies/2026/3/untitled-ontology-164#eventLocation -->

    <owl:DatatypeProperty rdf:about="http://www.semanticweb.org/laptop/ontologies/2026/3/untitled-ontology-164#eventLocation">
        <rdfs:domain rdf:resource="http://www.semanticweb.org/laptop/ontologies/2026/3/untitled-ontology-164#Tracking"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment>The physical facility or location describing where the tracking event took place.</rdfs:comment>
        <rdfs:label>event location</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://www.semanticweb.org/laptop/ontologies/2026/3/untitled-ontology-164#eventTime -->

    <owl:DatatypeProperty rdf:about="http://www.semanticweb.org/laptop/ontologies/2026/3/untitled-ontology-164#eventTime">
        <rdfs:domain rdf:resource="http://www.semanticweb.org/laptop/ontologies/2026/3/untitled-ontology-164#Tracking"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#dateTime"/>
        <rdfs:comment>The timestamp corresponding to a tracking update event.</rdfs:comment>
        <rdfs:label>event time</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://www.semanticweb.org/laptop/ontologies/2026/3/untitled-ontology-164#expectedDeliveryDate -->

    <owl:DatatypeProperty rdf:about="http://www.semanticweb.org/laptop/ontologies/2026/3/untitled-ontology-164#expectedDeliveryDate">
        <rdfs:domain rdf:resource="http://www.semanticweb.org/laptop/ontologies/2026/3/untitled-ontology-164#Order"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#date"/>
        <rdfs:comment>The projected date that the order items should arrive at the delivery address.</rdfs:comment>
        <rdfs:label>expected delivery date</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://www.semanticweb.org/laptop/ontologies/2026/3/untitled-ontology-164#paymentAmount -->

    <owl:DatatypeProperty rdf:about="http://www.semanticweb.org/laptop/ontologies/2026/3/untitled-ontology-164#paymentAmount">
        <rdfs:domain>
            <owl:Class>
                <owl:unionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="http://www.semanticweb.org/laptop/ontologies/2026/3/untitled-ontology-164#Invoice"/>
                    <rdf:Description rdf:about="http://www.semanticweb.org/laptop/ontologies/2026/3/untitled-ontology-164#Payment"/>
                </owl:unionOf>
            </owl:Class>
        </rdfs:domain>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
        <rdfs:comment>The monetary sum to be settled or that has been cleared.</rdfs:comment>
        <rdfs:label>payment amount</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://www.semanticweb.org/laptop/ontologies/2026/3/untitled-ontology-164#paymentId -->

    <owl:DatatypeProperty rdf:about="http://www.semanticweb.org/laptop/ontologies/2026/3/untitled-ontology-164#paymentId">
        <rdfs:domain rdf:resource="http://www.semanticweb.org/laptop/ontologies/2026/3/untitled-ontology-164#Payment"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment>The unique reference string corresponding to a payment.</rdfs:comment>
        <rdfs:label>payment ID</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://www.semanticweb.org/laptop/ontologies/2026/3/untitled-ontology-164#productId -->

    <owl:DatatypeProperty rdf:about="http://www.semanticweb.org/laptop/ontologies/2026/3/untitled-ontology-164#productId">
        <rdfs:domain rdf:resource="https://schema.org/Product"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment>The SKU or identifier for an individual product.</rdfs:comment>
        <rdfs:label>product ID</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://www.semanticweb.org/laptop/ontologies/2026/3/untitled-ontology-164#productName -->

    <owl:DatatypeProperty rdf:about="http://www.semanticweb.org/laptop/ontologies/2026/3/untitled-ontology-164#productName">
        <rdfs:domain rdf:resource="https://schema.org/Product"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment>The string name corresponding to a product.</rdfs:comment>
        <rdfs:label>product name</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://www.semanticweb.org/laptop/ontologies/2026/3/untitled-ontology-164#shipmentId -->

    <owl:DatatypeProperty rdf:about="http://www.semanticweb.org/laptop/ontologies/2026/3/untitled-ontology-164#shipmentId">
        <rdfs:domain rdf:resource="http://www.semanticweb.org/laptop/ontologies/2026/3/untitled-ontology-164#Shipment"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment>The unique string identifying a shipment batch.</rdfs:comment>
        <rdfs:label>shipment ID</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://www.semanticweb.org/laptop/ontologies/2026/3/untitled-ontology-164#totalAmount -->

    <owl:DatatypeProperty rdf:about="http://www.semanticweb.org/laptop/ontologies/2026/3/untitled-ontology-164#totalAmount">
        <rdfs:domain rdf:resource="http://www.semanticweb.org/laptop/ontologies/2026/3/untitled-ontology-164#Order"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
        <rdfs:comment>The total aggregate cost of the entire order.</rdfs:comment>
        <rdfs:label>total amount</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://www.semanticweb.org/laptop/ontologies/2026/3/untitled-ontology-164#unitPrice -->

    <owl:DatatypeProperty rdf:about="http://www.semanticweb.org/laptop/ontologies/2026/3/untitled-ontology-164#unitPrice">
        <rdfs:domain rdf:resource="https://schema.org/Product"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
        <rdfs:comment>The monetary price for a single unit of the product.</rdfs:comment>
        <rdfs:label>unit price</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- 
    ///////////////////////////////////////////////////////////////////////////////////////
    //
    // Classes
    //
    ///////////////////////////////////////////////////////////////////////////////////////
     -->

    


    <!-- http://purl.obolibrary.org/obo/IAO_0000310 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/IAO_0000310">
        <rdfs:subClassOf rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
        <rdfs:comment>A generic document classification from the OBO library.</rdfs:comment>
        <rdfs:label>Document</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.org/goodrelations/v1#ProductOrService -->

    <owl:Class rdf:about="http://purl.org/goodrelations/v1#ProductOrService">
        <rdfs:subClassOf rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
        <rdfs:comment>Represents either a product or a service available for purchase, as defined by GoodRelations.</rdfs:comment>
        <rdfs:label>Product or Service</rdfs:label>
    </owl:Class>
    


    <!-- http://schema.org/DeliveryEvent -->

    <owl:Class rdf:about="http://schema.org/DeliveryEvent">
        <rdfs:subClassOf rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
        <rdfs:comment>An event regarding the delivery of a shipment.</rdfs:comment>
        <rdfs:label>Delivery Event</rdfs:label>
    </owl:Class>
    


    <!-- http://schema.org/Organization -->

    <owl:Class rdf:about="http://schema.org/Organization">
        <rdfs:subClassOf rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
        <rdfs:comment>A generic class representing an organized body of people.</rdfs:comment>
        <rdfs:label>Organization</rdfs:label>
    </owl:Class>
    


    <!-- http://schema.org/TradeAction -->

    <owl:Class rdf:about="http://schema.org/TradeAction">
        <rdfs:subClassOf rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
        <rdfs:comment>An action pertaining to a commercial transaction.</rdfs:comment>
        <rdfs:label>Trade Action</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/laptop/ontologies/2026/3/untitled-ontology-164#Address -->

    <owl:Class rdf:about="http://www.semanticweb.org/laptop/ontologies/2026/3/untitled-ontology-164#Address">
        <rdfs:subClassOf rdf:resource="http://schema.org/DeliveryEvent"/>
        <rdfs:comment>A physical geographical location corresponding to a delivery event.</rdfs:comment>
        <rdfs:label>Address</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/laptop/ontologies/2026/3/untitled-ontology-164#Admin -->

    <owl:Class rdf:about="http://www.semanticweb.org/laptop/ontologies/2026/3/untitled-ontology-164#Admin">
        <rdfs:subClassOf rdf:resource="http://www.w3.org/2006/vcard/ns#Individual"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.semanticweb.org/laptop/ontologies/2026/3/untitled-ontology-164#sendsNotification"/>
                <owl:someValuesFrom rdf:resource="http://www.semanticweb.org/laptop/ontologies/2026/3/untitled-ontology-164#Notification"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <owl:disjointWith rdf:resource="http://www.semanticweb.org/laptop/ontologies/2026/3/untitled-ontology-164#Customer"/>
        <rdfs:comment>System administrator capable of initiating global actions such as notifications.</rdfs:comment>
        <rdfs:label>Admin</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/laptop/ontologies/2026/3/untitled-ontology-164#Cancellation -->

    <owl:Class rdf:about="http://www.semanticweb.org/laptop/ontologies/2026/3/untitled-ontology-164#Cancellation">
        <rdfs:subClassOf rdf:resource="http://schema.org/TradeAction"/>
        <rdfs:comment>An action that negates an order.</rdfs:comment>
        <rdfs:label>Cancellation</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/laptop/ontologies/2026/3/untitled-ontology-164#Customer -->

    <owl:Class rdf:about="http://www.semanticweb.org/laptop/ontologies/2026/3/untitled-ontology-164#Customer">
        <rdfs:subClassOf rdf:resource="http://www.w3.org/2006/vcard/ns#Individual"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.semanticweb.org/laptop/ontologies/2026/3/untitled-ontology-164#placesOrder"/>
                <owl:someValuesFrom rdf:resource="http://www.semanticweb.org/laptop/ontologies/2026/3/untitled-ontology-164#Order"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://schema.org/email"/>
                <owl:someValuesFrom rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://schema.org/telephone"/>
                <owl:someValuesFrom rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.semanticweb.org/laptop/ontologies/2026/3/untitled-ontology-164#customerName"/>
                <owl:someValuesFrom rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:comment>An individual purchasing a product or service.</rdfs:comment>
        <rdfs:label>Customer</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/laptop/ontologies/2026/3/untitled-ontology-164#DeliveredOrder -->

    <owl:Class rdf:about="http://www.semanticweb.org/laptop/ontologies/2026/3/untitled-ontology-164#DeliveredOrder">
        <owl:equivalentClass>
            <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="http://www.semanticweb.org/laptop/ontologies/2026/3/untitled-ontology-164#Order"/>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="http://www.semanticweb.org/laptop/ontologies/2026/3/untitled-ontology-164#hasPayment"/>
                        <owl:someValuesFrom rdf:resource="http://www.semanticweb.org/laptop/ontologies/2026/3/untitled-ontology-164#Payment"/>
                    </owl:Restriction>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="http://www.semanticweb.org/laptop/ontologies/2026/3/untitled-ontology-164#hasShipment"/>
                        <owl:someValuesFrom rdf:resource="http://www.semanticweb.org/laptop/ontologies/2026/3/untitled-ontology-164#Shipment"/>
                    </owl:Restriction>
                </owl:intersectionOf>
            </owl:Class>
        </owl:equivalentClass>
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/laptop/ontologies/2026/3/untitled-ontology-164#Order"/>
        <rdfs:comment>A fully processed order equipped with a payment record and shipment trace.</rdfs:comment>
        <rdfs:label>Delivered Order</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/laptop/ontologies/2026/3/untitled-ontology-164#Invoice -->

    <owl:Class rdf:about="http://www.semanticweb.org/laptop/ontologies/2026/3/untitled-ontology-164#Invoice">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/IAO_0000310"/>
        <owl:disjointWith rdf:resource="http://www.semanticweb.org/laptop/ontologies/2026/3/untitled-ontology-164#Notification"/>
        <rdfs:comment>A formal document establishing order cost parameters for customer payment.</rdfs:comment>
        <rdfs:label>Invoice</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/laptop/ontologies/2026/3/untitled-ontology-164#Notification -->

    <owl:Class rdf:about="http://www.semanticweb.org/laptop/ontologies/2026/3/untitled-ontology-164#Notification">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/IAO_0000310"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.semanticweb.org/laptop/ontologies/2026/3/untitled-ontology-164#notifiesCustomer"/>
                <owl:someValuesFrom rdf:resource="http://www.semanticweb.org/laptop/ontologies/2026/3/untitled-ontology-164#Customer"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:comment>A message or update sent systematically to a customer regarding order states.</rdfs:comment>
        <rdfs:label>Notification</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/laptop/ontologies/2026/3/untitled-ontology-164#Order -->

    <owl:Class rdf:about="http://www.semanticweb.org/laptop/ontologies/2026/3/untitled-ontology-164#Order">
        <rdfs:subClassOf rdf:resource="http://schema.org/TradeAction"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.semanticweb.org/laptop/ontologies/2026/3/untitled-ontology-164#containsItem"/>
                <owl:someValuesFrom rdf:resource="https://schema.org/OrderItem"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://schema.org/orderNumber"/>
                <owl:someValuesFrom rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.semanticweb.org/laptop/ontologies/2026/3/untitled-ontology-164#totalAmount"/>
                <owl:someValuesFrom rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <owl:disjointWith rdf:resource="http://www.semanticweb.org/laptop/ontologies/2026/3/untitled-ontology-164#Payment"/>
        <rdfs:comment>Represents a transactional order placed by a customer.</rdfs:comment>
        <rdfs:label>Order</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/laptop/ontologies/2026/3/untitled-ontology-164#Payment -->

    <owl:Class rdf:about="http://www.semanticweb.org/laptop/ontologies/2026/3/untitled-ontology-164#Payment">
        <rdfs:subClassOf rdf:resource="http://schema.org/TradeAction"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://schema.org/paymentMethod"/>
                <owl:someValuesFrom rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
